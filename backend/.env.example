APP_ENV=development
APP_NAME=MediaDL
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev (change to PostgreSQL for production):
DATABASE_URL=sqlite+aiosqlite:///./mediadl.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mediadl

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Set to true to use in-memory fakeredis (no Redis server needed)
USE_FAKE_REDIS=true

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
TEMP_DIR=./storage/temp
COMPLETED_DIR=./storage/completed

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=3
MAX_JOB_DURATION=3600
MAX_DOWNLOAD_SIZE_MB=2048
FILE_RETENTION_SECONDS=3600

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_INFO=10/minute
RATE_LIMIT_DOWNLOAD=5/minute

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── FFmpeg ────────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string-here

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
